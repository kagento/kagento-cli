#!/usr/bin/env bash
set -euo pipefail

# Kagento CLI
# Usage:
#   kagento check <session_id>   - Run tests without stopping (preview score)
#   kagento submit <session_id>  - Final submit (stops session, records score)
#   kagento status <session_id>  - Check session status

KAGENTO_API="${KAGENTO_API:-http://localhost:8080/v1/graphql}"
KAGENTO_BACKEND="${KAGENTO_BACKEND:-http://localhost:8081}"
KAGENTO_REGISTRY="${KAGENTO_REGISTRY:-localhost:5000}"
KAGENTO_TOKEN="${KAGENTO_TOKEN:-}"
KAGENTO_ADMIN_SECRET="${KAGENTO_ADMIN_SECRET:-}"
KAGENTO_USER_ID="${KAGENTO_USER_ID:-}"

_headers() {
  if [ -n "$KAGENTO_TOKEN" ]; then
    echo "-H" "Authorization: Bearer $KAGENTO_TOKEN"
  elif [ -n "$KAGENTO_ADMIN_SECRET" ]; then
    echo "-H" "x-hasura-admin-secret: $KAGENTO_ADMIN_SECRET"
    if [ -n "$KAGENTO_USER_ID" ]; then
      echo "-H" "x-hasura-role: user" "-H" "x-hasura-user-id: $KAGENTO_USER_ID"
    fi
  else
    echo "Error: Set KAGENTO_TOKEN or KAGENTO_ADMIN_SECRET" >&2
    exit 1
  fi
}

_graphql() {
  local query="$1"
  local headers
  headers=($(_headers))
  curl -sf "$KAGENTO_API" \
    "${headers[@]}" \
    -H "Content-Type: application/json" \
    -d "$query"
}

cmd_check() {
  local session_id="$1"
  echo "⏳ Running tests for session $session_id..."

  local result
  result=$(_graphql "{\"query\":\"mutation { checkSession(session_id: \\\"$session_id\\\") { session_id score details } }\"}")

  local score
  score=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['checkSession']['score'])" 2>/dev/null)

  if [ -n "$score" ]; then
    local details
    details=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin)['data']['checkSession']['details']; print(json.dumps(d,indent=2))" 2>/dev/null || echo "{}")
    echo ""
    echo "📊 Score: $score/100"
    echo "$details"
    echo ""
    echo "Session still running. Use 'kagento submit $session_id' to finalize."
  else
    echo "❌ Error:"
    echo "$result" | python3 -m json.tool 2>/dev/null || echo "$result"
    exit 1
  fi
}

cmd_submit() {
  local session_id="$1"
  echo "🏁 Finishing session $session_id..."

  local result
  result=$(_graphql "{\"query\":\"mutation { finishSession(session_id: \\\"$session_id\\\") { submission_id score details duration_sec } }\"}")

  local score
  score=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['finishSession']['score'])" 2>/dev/null)

  if [ -n "$score" ]; then
    local duration submission_id details
    duration=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin)['data']['finishSession']; print(f\"{d['duration_sec']//60}m {d['duration_sec']%60}s\")" 2>/dev/null)
    submission_id=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['finishSession']['submission_id'])" 2>/dev/null)
    details=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin)['data']['finishSession']['details']; print(json.dumps(d,indent=2))" 2>/dev/null || echo "{}")
    echo ""
    echo "✅ Session complete!"
    echo "📊 Score: $score/100"
    echo "⏱  Duration: $duration"
    echo "🆔 Submission: $submission_id"
    echo "$details"
  else
    echo "❌ Error:"
    echo "$result" | python3 -m json.tool 2>/dev/null || echo "$result"
    exit 1
  fi
}

cmd_status() {
  local session_id="$1"

  local result
  result=$(_graphql "{\"query\":\"query { sessions_by_pk(id: \\\"$session_id\\\") { id status started_at finished_at task { title } } }\"}")

  echo "$result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
s = d.get('data', {}).get('sessions_by_pk')
if not s:
    print('Session not found')
    sys.exit(1)
print(f\"Session: {s['id']}\")
print(f\"Task:    {s['task']['title']}\")
print(f\"Status:  {s['status']}\")
if s.get('started_at'):
    print(f\"Started: {s['started_at']}\")
if s.get('finished_at'):
    print(f\"Finished: {s['finished_at']}\")
" 2>/dev/null || echo "$result"
}

cmd_auth() {
  echo "Authenticating with Kagento registry..."

  local headers
  headers=($(_headers))

  local result
  result=$(curl -sf "$KAGENTO_BACKEND/api/registry/token" \
    "${headers[@]}" \
    -X POST \
    -H "Content-Type: application/json" \
    -d '{}')

  if [ -z "$result" ]; then
    echo "Error: failed to get registry token. Check your credentials." >&2
    exit 1
  fi

  local username password registry
  username=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['username'])")
  password=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['password'])")
  registry=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['registry'])")

  echo "$password" | docker login "$registry" -u "$username" --password-stdin
  echo "Logged in to $registry (token expires in 15 min)"
}

cmd_push() {
  local slug="${1:-}"
  if [ -z "$slug" ]; then
    echo "Usage: kagento push <slug>" >&2
    exit 1
  fi

  local user_id="$KAGENTO_USER_ID"
  if [ -z "$user_id" ]; then
    echo "Error: KAGENTO_USER_ID is required for push" >&2
    exit 1
  fi

  local registry="$KAGENTO_REGISTRY"
  local base="$registry/public/$user_id/$slug"

  echo "Pushing task images for '$slug'..."

  # Check if task and test images exist locally
  if ! docker image inspect "${slug}:task" &>/dev/null; then
    echo "Error: Image '${slug}:task' not found. Build it first." >&2
    exit 1
  fi
  if ! docker image inspect "${slug}:test" &>/dev/null; then
    echo "Error: Image '${slug}:test' not found. Build it first." >&2
    exit 1
  fi

  # Tag
  docker tag "${slug}:task" "$base:task"
  docker tag "${slug}:test" "$base:test"

  # Push
  docker push "$base:task"
  docker push "$base:test"

  echo ""
  echo "Pushed:"
  echo "   $base:task"
  echo "   $base:test"
  echo ""
  echo "Create task on the platform with these image refs."
}

usage() {
  cat <<EOF
Kagento CLI

Usage:
  kagento check  <session_id>   Run tests without stopping (preview score)
  kagento submit <session_id>   Final submit (stops session, records score)
  kagento status <session_id>   Check session status
  kagento auth                  Authenticate with the Docker registry
  kagento push   <slug>         Push task + test images to registry

Environment:
  KAGENTO_API           GraphQL endpoint (default: http://localhost:8080/v1/graphql)
  KAGENTO_BACKEND       Backend HTTP endpoint (default: http://localhost:8081)
  KAGENTO_REGISTRY      Docker registry address (default: localhost:5000)
  KAGENTO_TOKEN         Auth token (JWT from Keycloak)
  KAGENTO_ADMIN_SECRET  Admin secret (dev mode)
  KAGENTO_USER_ID       User ID (required with admin secret and push)
EOF
}

case "${1:-}" in
  check)
    [ -z "${2:-}" ] && { echo "Usage: kagento check <session_id>"; exit 1; }
    cmd_check "$2"
    ;;
  submit)
    [ -z "${2:-}" ] && { echo "Usage: kagento submit <session_id>"; exit 1; }
    cmd_submit "$2"
    ;;
  status)
    [ -z "${2:-}" ] && { echo "Usage: kagento status <session_id>"; exit 1; }
    cmd_status "$2"
    ;;
  auth)
    cmd_auth
    ;;
  push)
    [ -z "${2:-}" ] && { echo "Usage: kagento push <slug>"; exit 1; }
    cmd_push "$2"
    ;;
  *)
    usage
    ;;
esac
